<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_tunnel_setup_intro"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_load_dns"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dns_tunnel_load_public" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/dns_tunnel_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_connection_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/sp_subscription_profile"
            android:text="@string/dns_tunnel_subscription_profile"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead" />
        <Spinner
            android:id="@+id/sp_subscription_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:spinnerMode="dialog"
            android:prompt="@string/dns_tunnel_subscription_profile" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_tunnel_subscription_help"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/dns_tunnel_domain"
            app:helperText="@string/dns_tunnel_domain_help"
            app:placeholderText="t.example.com">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dns_domain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLength="100"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/dns_tunnel_public_key"
            app:helperText="@string/dns_tunnel_public_key_help">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dns_public_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword|textMultiLine"
                android:maxLength="128"
                android:minLines="2"
                android:gravity="top"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/dns_tunnel_resolvers"
            app:helperText="@string/dns_tunnel_resolvers_help">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dns_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textNoSuggestions"
                android:gravity="top"
                android:minLines="2"
                android:maxLength="512"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_dns_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_dns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dns_tunnel_save_connection" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_dns"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_tunnel_import_file" />
    </LinearLayout>
</ScrollView>
